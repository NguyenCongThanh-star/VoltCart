flowchart TD
    start(["Khách bấm Thanh toán"]) --> empty{"Giỏ hàng có sản phẩm?"}
    empty -- "Không" --> back["Quay lại giỏ hàng, báo giỏ trống"]
    empty -- "Có" --> login{"Đã đăng nhập?"}

    login -- "Có" --> fm["Form điền sẵn từ hồ sơ, dùng giá thành viên"]
    login -- "Không" --> fg["Form trống, dùng giá khách, không cần tài khoản"]

    fm --> pay["Chọn thanh toán: COD hoặc chuyển khoản giả lập"]
    fg --> pay
    pay --> submit["Bấm Đặt hàng"]

    submit --> v1{"Thông tin giao hàng hợp lệ?"}
    v1 -- "Không" --> err1["Hiện lỗi ngay tại ô nhập sai"]
    err1 --> pay
    v1 -- "Có" --> v2{"Mọi sản phẩm còn đủ hàng?"}
    v2 -- "Không" --> err2["Báo sản phẩm thiếu hàng, quay lại giỏ"]
    v2 -- "Có" --> v3{"Mã giảm giá còn hợp lệ?"}
    v3 -- "Không" --> drop["Gỡ mã, tính lại tổng"]
    v3 -- "Có hoặc không dùng mã" --> tx
    drop --> tx

    subgraph tx["Một giao dịch: thành công hết hoặc không đổi gì"]
        t1["Tạo đơn hàng, trạng thái Pending"] --> t2["Chép tên và đơn giá từng sản phẩm vào đơn"]
        t2 --> t3["Trừ tồn kho"]
    end

    tx --> clear["Xóa giỏ hàng"]
    clear --> done(["Trang xác nhận: mã đơn, tổng tiền, cách thanh toán"])
