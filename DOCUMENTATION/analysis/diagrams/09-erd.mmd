erDiagram
    USERS ||--o{ ORDERS : "đặt"
    USERS ||--o| CONVERSATIONS : "có"
    USERS ||--o{ MESSAGES : "gửi"
    CATEGORIES ||--o{ PRODUCTS : "chứa"
    PRODUCTS ||--o{ PRODUCT_IMAGES : "có"
    PRODUCTS ||--o{ ORDER_ITEMS : "được mua trong"
    ORDERS ||--|{ ORDER_ITEMS : "gồm"
    COUPONS ||--o{ ORDERS : "áp dụng cho"
    CONVERSATIONS ||--o{ MESSAGES : "gồm"

    USERS {
        bigint id PK
        string name
        string email UK
        string password
        string phone
        string address
        string role "customer hoặc admin"
        string status "active hoặc locked"
    }

    CATEGORIES {
        bigint id PK
        string name
        string slug UK
        boolean is_active
    }

    PRODUCTS {
        bigint id PK
        bigint category_id FK
        string name
        string slug UK
        string brand
        int ram_gb
        int storage_gb
        decimal screen_size
        bigint guest_price "giá khách - VND"
        bigint member_price "giá thành viên - VND"
        int stock "tồn kho"
        text description
        text specifications
        boolean is_featured
        string status "active hoặc hidden"
    }

    PRODUCT_IMAGES {
        bigint id PK
        bigint product_id FK
        string path
        string alt_text
        boolean is_primary
    }

    COUPONS {
        bigint id PK
        string code UK
        bigint discount_amount "số tiền giảm"
        bigint min_order_amount "đơn tối thiểu"
        boolean is_active
    }

    ORDERS {
        bigint id PK
        string code UK "mã đơn"
        bigint user_id FK "rỗng nếu là khách vãng lai"
        bigint coupon_id FK "rỗng nếu không dùng mã"
        string customer_name
        string customer_email
        string customer_phone
        string shipping_address
        string payment_method "cod hoặc bank_transfer"
        bigint subtotal "tạm tính"
        bigint discount "giảm giá"
        bigint shipping_fee "phí giao hàng"
        bigint total "tổng tiền"
        string status "pending, confirmed, shipping, completed, cancelled"
    }

    ORDER_ITEMS {
        bigint id PK
        bigint order_id FK
        bigint product_id FK
        string product_name "tên lúc mua"
        bigint unit_price "đơn giá lúc mua"
        int quantity
        bigint line_total
    }

    CONVERSATIONS {
        bigint id PK
        bigint user_id FK "mỗi thành viên một cuộc"
        datetime last_message_at
    }

    MESSAGES {
        bigint id PK
        bigint conversation_id FK
        bigint sender_id FK
        text body
        boolean is_read
    }
